{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="d-flex flex-column">
    <div class="row">
        <div class="col">
            <div class='p-2 flex-grow-1 card'>
                <div class="asset">
                    <form id="main-form" name="uibranding_form" method="post" action="{{ url }}"
                          enctype="multipart/form-data"
                          data-submit-once>
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>
                        {{ fields.largeTitle(__('UI Branding', 'glpimod'), 'ti ti-paint', true) }}
                        <div class="card-body d-flex flex-wrap">
                            <div class="col-12 col-xxl-12 flex-column">
                                <div class="d-flex flex-row flex-wrap flex-xl-nowrap">
                                    <div class="row flex-row align-items-start flex-grow-1">
                                        <div class="row flex-row">
                                            {{ fields.smallTitle(__('Apply Modifications', 'glpimod'), 'ti ti-adjustments') }}
                                            {{ fields.textField('title', title, __('Page Title', 'glpimod')) }}
                                            {{ fields.dropdownYesNo('show_background', show_background, __('Show login background', 'glpimod')) }}
                                            {{ fields.smallTitle(__('Login Box', 'glpimod'), 'ti ti-tune-vertical') }}
<div class="row">
    <div class="col-md-6">
        <div class="form-field row align-items-center mb-2">
            <label class="col-form-label col-md-5 text-md-end">{{ __('Box opacity', 'glpimod') }}</label>
            <div class="col-md-7 field-container">
                <input type="range" class="form-range" name="login_opacity" id="login_opacity"
                       min="0.05" max="1" step="0.05" value="{{ login_opacity|default('0.65') }}"/>
                <output for="login_opacity" id="opacity_value" class="ms-2 fw-bold">{{ login_opacity|default('0.65') }}</output>
                <small class="form-text text-muted d-block">{{ __('0.05 = transparente, 1 = sólido', 'glpimod') }}</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="login-preview position-relative p-4 rounded-3 border" 
             style="background-color: rgba(255,255,255,{{ login_opacity|default('0.65') }}); border: 1px solid rgba(255,255,255,0.4); min-height: 140px;">
            <div class="text-center position-absolute top-50 start-50 translate-middle">
                <i class="ti ti-login ti-4x text-primary mb-2"></i>
                <h6 class="text-primary">{{ __('Live Preview', 'glpimod') }}</h6>
                <small class="text-muted">opacity: <span id="live_opacity">{{ login_opacity|default('0.65') }}</span></small>
            </div>
        </div>
    </div>
</div>
                                            {{ fields.dropdownYesNo('show_custom_logos', show_custom_logos, __('Show custom logos', 'glpimod')) }}
                                            {{ fields.dropdownYesNo('show_custom_favicon', show_custom_favicon, __('Show custom favicon', 'glpimod')) }}
                                            {{ fields.smallTitle(__('Custom Images', 'glpimod'), 'ti ti-photo') }}
                                            {# Video MP4 (prioridad 1) #}
<div class="form-field row align-items-center col-12 col-sm-6 mb-2">
    <label class="col-form-label col-xxl-5 text-xxl-end" for="background_video_input">
        {{ __('Login Background Video (.mp4)', 'glpimod') }}
    </label>
    <div class="col-xxl-7 field-container">
        <input type="file" class="form-control" name="background_video" accept="video/mp4" id="background_video_input"/>
        <small class="form-text text-muted">1920x1080, &lt;10MB recomendado</small>
    </div>
</div>
<div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
    {% if has_video %}
    <video width="200" height="112" controls muted loop style="border-radius: 8px;">
        <source src="{{ plugin_url }}/front/resource.send.php?resource=background_video" type="video/mp4">
    </video>
    {% else %}
    <span class="text-muted">{{ __('No background video uploaded (the JPG image is used)', 'glpimod') }}</span>
    {% endif %}
</div>

{# Imagen JPG (fallback) #}
<div class="form-field row align-items-center col-12 col-sm-6 mb-2">
    <label class="col-form-label col-xxl-5 text-xxl-end" for="background_input">
        {{ __('Background Image (fallback JPG)', 'glpimod') }}
    </label>
    <div class="col-xxl-7 field-container">
        <input type="file" class="form-control" name="background" accept="image/jpeg" id="background_input"/>
    </div>
</div>
<div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
    <img style='max-width: 100%; max-height: 250px; width: auto; border-radius: 8px;'
         src='{{ plugin_url }}/front/resource.send.php?resource=background'
         alt='{{ __('Background', 'glpimod') }}'/>
</div>
                                            <div class="row border-top mb-2 ms-2 me-2"></div>
                                            <div class="form-field row align-items-center col-12 col-sm-6  mb-2">
                                                <label class="col-form-label col-xxl-5 text-xxl-end "
                                                       for="logo_s_input">
                                                    {{ __('Small Logo (53x53 - PNG)', 'glpimod') }}
                                                </label>
                                                <div class="col-xxl-7  field-container">
                                                    <input type="file" class="form-control" name="logo_s"
                                                           accept="image/png" id="logo_s_input"/>
                                                </div>
                                            </div>
                                            <div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
                                                <img style='max-width: 100%; max-height: 250px; width: auto'
                                                     src='{{ plugin_url }}/front/resource.send.php?resource=logo_s'
                                                     alt='{{ __('Small Logo', 'glpimod') }}'/>
                                            </div>
                                            <div class="row border-top mb-2 ms-2 me-2"></div>
                                            <div class="form-field row align-items-center col-12 col-sm-6  mb-2">
                                                <label class="col-form-label col-xxl-5 text-xxl-end "
                                                       for="logo_m_input">
                                                    {{ __('Medium Logo (100x55 - PNG)', 'glpimod') }}
                                                </label>
                                                <div class="col-xxl-7  field-container">
                                                    <input type="file" class="form-control" name="logo_m"
                                                           accept="image/png" id="logo_m_input"/>
                                                </div>
                                            </div>
                                            <div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
                                                <img style='max-width: 100%; max-height: 250px; width: auto'
                                                     src='{{ plugin_url }}/front/resource.send.php?resource=logo_m'
                                                     alt='{{ __('Medium Logo', 'glpimod') }}'/>
                                            </div>
                                            <div class="row border-top mb-2 ms-2 me-2"></div>
                                            <div class="form-field row align-items-center col-12 col-sm-6  mb-2">
                                                <label class="col-form-label col-xxl-5 text-xxl-end "
                                                       for="logo_l_input">
                                                    {{ __('Large Logo (250x138 - PNG)', 'glpimod') }}
                                                </label>
                                                <div class="col-xxl-7  field-container">
                                                    <input type="file" class="form-control" name="logo_l"
                                                           accept="image/png" id="logo_l_input"/>
                                                </div>
                                            </div>
                                            <div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
                                                <img style='max-width: 100%; max-height: 250px; width: auto'
                                                     src='{{ plugin_url }}/front/resource.send.php?resource=logo_l'
                                                     alt='{{ __('Large Logo', 'glpimod') }}'/>
                                            </div>
                                            <div class="row border-top mb-2 ms-2 me-2"></div>
                                            <div class="form-field row align-items-center col-12 col-sm-6  mb-2">
                                                <label class="col-form-label col-xxl-5 text-xxl-end "
                                                       for="favicon_input">
                                                    {{ __('Favicon (16x16 - ICO)', 'glpimod') }}
                                                </label>
                                                <div class="col-xxl-7  field-container">
                                                    <input type="file" class="form-control" name="favicon"
                                                           accept=".ico,image/x-icon" id="favicon_input"/>
                                                </div>
                                            </div>
                                            <div class="row align-items-center justify-content-center col-12 col-sm-6 mb-2">
                                                <img style='max-width: 100%; max-height: 250px; width: auto'
                                                     src='{{ plugin_url }}/front/resource.send.php?resource=favicon'
                                                     alt='{{ __('Favicon', 'glpimod') }}'/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-button-separator card-body mx-n2 border-top d-flex flex-row-reverse align-items-start flex-wrap">
                            <button class="btn btn-primary me-2" type="submit" name="update" value="1">
                                <i class="ti ti-device-floppy"></i>
                                <span>{{ _x('button', 'Save') }}</span>
                            </button>
                        </div>
                        <div class="card-footer mx-n2 mb-n2"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const slider = document.getElementById('login_opacity');
    const value = document.getElementById('opacity_value');
    const preview = document.querySelector('.login-preview');
    const liveOpacity = document.getElementById('live_opacity');
    
    if (!slider) {
        console.error('❌ Slider login_opacity no encontrado');
        return;
    }
    
    slider.addEventListener('input', function() {
        const opacity = parseFloat(this.value);
        value.textContent = opacity.toFixed(2);
        if (liveOpacity) liveOpacity.textContent = opacity.toFixed(2);
        if (preview) {
            preview.style.backgroundColor = `rgba(255,255,255,${opacity})`;
            preview.style.borderColor = `rgba(255,255,255,${opacity * 0.6})`;
        }
        console.log('🎚️ Opacity:', opacity);
    });
    
    console.log('✅ Slider inicializado');
});
</script>


