{# ---------- Small building blocks ---------- #}

{% macro switch(name, checked, label, help) %}
    <input type="hidden" name="{{ name }}" value="0"/>
    <label class="form-check form-switch mb-1">
        <input class="form-check-input" type="checkbox" name="{{ name }}" value="1" {{ checked ? 'checked' : '' }}/>
        <span class="form-check-label fw-bold">{{ label }}</span>
    </label>
    {% if help %}<div class="form-hint mb-0">{{ help }}</div>{% endif %}
{% endmacro %}

{% macro upload(name, accept, hint, preview_target) %}
    <input type="file" class="form-control form-control-sm glpimod-upload" name="{{ name }}" id="glpimod_{{ name }}"
           accept="{{ accept }}" {% if preview_target %}data-preview="{{ preview_target }}"{% endif %}/>
    {% if hint %}<div class="form-hint mt-1">{{ hint }}</div>{% endif %}
{% endmacro %}

{% macro status(active, on_label, off_label) %}
    {% if active %}
        <span class="badge bg-green-lt"><i class="ti ti-check me-1"></i>{{ on_label }}</span>
    {% else %}
        <span class="badge bg-secondary-lt">{{ off_label }}</span>
    {% endif %}
{% endmacro %}

{% import _self as ui %}

{% set bg_url = preview_url ~ '?resource=background&v=' ~ background.version %}
{% set video_url = preview_url ~ '?resource=background_video&v=' ~ video.version %}
{% set logo_l_url = preview_url ~ '?resource=logo_l&variant=black&v=' ~ logos.logo_l.info.version %}

<style>
    .glpimod-tile { display:flex; align-items:center; justify-content:center; height:96px; border-radius:8px;
                    border:1px solid rgba(0,0,0,.08); padding:8px; }
    .glpimod-tile img { max-width:100%; max-height:100%; object-fit:contain; }
    .glpimod-tile.light { background:#ffffff; }
    .glpimod-tile.dark { background:#1f2937; }
    .glpimod-preview { position:relative; overflow:hidden; border-radius:10px; aspect-ratio:16/9;
                       background:#d9dee5 center/cover no-repeat; border:1px solid rgba(0,0,0,.1); }
    .glpimod-preview video { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .glpimod-preview .glpimod-box { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
                       width:42%; min-width:180px; padding:14px; border-radius:12px; text-align:center;
                       border:1px solid rgba(255,255,255,.5); box-shadow:0 10px 30px rgba(0,0,0,.25); }
    .glpimod-box img { max-width:70%; max-height:46px; margin-bottom:8px; }
    .glpimod-fake-input { height:10px; border-radius:4px; background:rgba(0,0,0,.12); margin:6px 0; }
    .glpimod-fake-btn { height:14px; border-radius:4px; background:var(--tblr-primary, #206bc4); opacity:.7; margin-top:10px; }
    .glpimod-browser-tab { display:inline-flex; align-items:center; gap:8px; padding:8px 14px; border-radius:10px 10px 0 0;
                       background:#fff; border:1px solid rgba(0,0,0,.1); border-bottom:none; max-width:100%; }
    .glpimod-browser-tab img { width:16px; height:16px; }
    .glpimod-browser-bar { height:10px; background:#fff; border:1px solid rgba(0,0,0,.1); border-top:none; border-radius:0 0 8px 8px; }
    .glpimod-hd-preview { position:relative; overflow:hidden; border-radius:10px; height:250px;
                          background:var(--glpi-helpdesk-header, #c9e2f4); border:1px solid rgba(0,0,0,.08); }
    .glpimod-hd-preview .scene { position:absolute; bottom:0; width:36%; height:90%; display:flex; align-items:flex-end; overflow:hidden; }
    .glpimod-hd-preview .scene svg { width:100%; height:auto; aspect-ratio:842/596; }
    .glpimod-hd-preview .scene-left { left:0; }
    .glpimod-hd-preview .scene-right { right:0; }
    .glpimod-hd-title { position:absolute; top:42%; left:50%; transform:translate(-50%,-50%); width:30%; text-align:center;
                        font-weight:600; font-size:1rem; color:#2d3748; }
    .glpimod-hd-search { height:14px; border-radius:4px; background:#fff; margin-top:10px; box-shadow:0 1px 2px rgba(0,0,0,.1); }
    .glpimod-section-title { font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; color:var(--tblr-muted, #667382); font-weight:600; }
</style>

<form id="glpimod-form" name="uibranding_form" method="post" action="{{ url }}" enctype="multipart/form-data" data-submit-once>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>

    <div class="card">
        {# ---------- Header with current status ---------- #}
        <div class="card-header d-flex flex-wrap align-items-center gap-2">
            <h3 class="card-title me-auto mb-0">
                <i class="ti ti-paint me-2"></i>{{ __('Branding', 'glpimod') }}
                <span class="badge bg-blue-lt ms-2">glpimod {{ version }}</span>
            </h3>
            <span class="text-muted small me-1">{{ __('Login background', 'glpimod') }}:</span>
            {% if not show_background %}
                <span class="badge bg-secondary-lt">{{ __('Disabled', 'glpimod') }}</span>
            {% elseif video.exists %}
                <span class="badge bg-green-lt"><i class="ti ti-movie me-1"></i>{{ __('Video', 'glpimod') }}</span>
            {% else %}
                <span class="badge bg-green-lt"><i class="ti ti-photo me-1"></i>{{ __('Image', 'glpimod') }}</span>
            {% endif %}
            <span class="text-muted small ms-2 me-1">{{ __('Logos', 'glpimod') }}:</span>
            {{ ui.status(show_custom_logos, __('Custom', 'glpimod'), 'GLPI') }}
            <span class="text-muted small ms-2 me-1">{{ __('Favicon', 'glpimod') }}:</span>
            {{ ui.status(show_custom_favicon, __('Custom', 'glpimod'), 'GLPI') }}
        </div>

        <div class="card-header pt-0 border-bottom-0">
            <ul class="nav nav-tabs card-header-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <a href="#glpimod-tab-general" class="nav-link active" data-bs-toggle="tab" role="tab">
                        <i class="ti ti-browser me-2"></i>{{ __('Title and favicon', 'glpimod') }}
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#glpimod-tab-login" class="nav-link" data-bs-toggle="tab" role="tab">
                        <i class="ti ti-login me-2"></i>{{ __('Login page', 'glpimod') }}
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#glpimod-tab-logos" class="nav-link" data-bs-toggle="tab" role="tab">
                        <i class="ti ti-badge me-2"></i>{{ __('Logos', 'glpimod') }}
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#glpimod-tab-helpdesk" class="nav-link" data-bs-toggle="tab" role="tab">
                        <i class="ti ti-lifebuoy me-2"></i>{{ __('Self-service portal', 'glpimod') }}
                    </a>
                </li>
                <li class="nav-item" role="presentation">
                    <a href="#glpimod-tab-texts" class="nav-link" data-bs-toggle="tab" role="tab">
                        <i class="ti ti-language me-2"></i>{{ __('Texts', 'glpimod') }}
                        {% if tiles_suggestions or override_suggestions|length %}
                            <span class="badge bg-orange text-white ms-2">{{ tiles_suggestions + override_suggestions|length }}</span>
                        {% endif %}
                    </a>
                </li>
            </ul>
        </div>

        <div class="card-body tab-content">

            {# ================= TAB: title and favicon ================= #}
            <div class="tab-pane active show" id="glpimod-tab-general" role="tabpanel">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="glpimod-section-title mb-2">{{ __('Page title', 'glpimod') }}</div>
                        <input type="text" class="form-control" name="title" id="glpimod_title" value="{{ title }}" maxlength="100"/>
                        <div class="form-hint">{{ __('Shown in the browser tab and as the application name.', 'glpimod') }}</div>

                        <div class="glpimod-section-title mt-4 mb-2">{{ __('Favicon', 'glpimod') }}</div>
                        {{ ui.switch('show_custom_favicon', show_custom_favicon, __('Use custom favicon', 'glpimod'), __('If disabled, the original GLPI favicon is restored.', 'glpimod')) }}
                        <div class="mt-3">
                            {{ ui.upload('favicon', '.ico,image/x-icon,image/vnd.microsoft.icon', __('ICO file, 16×16 or 32×32 px.', 'glpimod'), 'glpimod_favicon_preview') }}
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="glpimod-section-title mb-2">{{ __('Preview', 'glpimod') }}</div>
                        <div class="p-3 rounded-3" style="background:#e9edf2;">
                            <div class="glpimod-browser-tab">
                                <img id="glpimod_favicon_preview" src="{{ preview_url }}?resource=favicon&v={{ favicon.version }}" alt=""/>
                                <span id="glpimod_title_preview" class="text-truncate">{{ title }}</span>
                            </div>
                            <div class="glpimod-browser-bar"></div>
                        </div>
                    </div>
                </div>
            </div>

            {# ================= TAB: login page ================= #}
            <div class="tab-pane" id="glpimod-tab-login" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-6">
                        {{ ui.switch('show_background', show_background, __('Customize the login page', 'glpimod'), __('Background image or video, and login box transparency.', 'glpimod')) }}

                        <div class="glpimod-section-title mt-4 mb-2">{{ __('Login box opacity', 'glpimod') }}</div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="small text-muted">{{ __('Transparent', 'glpimod') }}</span>
                            <input type="range" class="form-range flex-grow-1" name="login_opacity" id="glpimod_opacity"
                                   min="0.05" max="1" step="0.05" value="{{ login_opacity|default('0.65') }}"/>
                            <span class="small text-muted">{{ __('Solid', 'glpimod') }}</span>
                            <span class="badge bg-blue-lt" id="glpimod_opacity_value" style="min-width:3.2rem;">{{ login_opacity|default('0.65') }}</span>
                        </div>

                        <div class="glpimod-section-title mt-4 mb-2">{{ __('Background video', 'glpimod') }} <span class="text-lowercase fw-normal">({{ __('optional', 'glpimod') }})</span></div>
                        {% if compression.state == 'done' %}
                            <div class="alert alert-success py-2 mb-2">
                                <i class="ti ti-circle-check me-1"></i>{{ __('Video compressed: %1$s → %2$s. The login page already uses the new version.', 'glpimod')|format(compression.old_label, compression.new_label) }}
                            </div>
                        {% elseif compression.state == 'nogain' %}
                            <div class="alert alert-info py-2 mb-2">
                                <i class="ti ti-info-circle me-1"></i>{{ __('The video was already optimized: compressing it would not make it smaller, so the original was kept.', 'glpimod') }}
                            </div>
                        {% elseif compression.state == 'failed' %}
                            <div class="alert alert-danger py-2 mb-2">
                                <i class="ti ti-alert-circle me-1"></i>{{ __('The video could not be compressed. The original video was kept.', 'glpimod') }}
                            </div>
                        {% endif %}

                        {% if video.exists %}
                            {% if compression.state == 'running' %}
                                <div id="glpimod_compress" class="border rounded-3 p-2 mb-2" data-status-url="{{ compress_status_url }}">
                                    <div class="d-flex align-items-center gap-2 small mb-1">
                                        <span class="spinner-border spinner-border-sm text-primary"></span>
                                        <span>{{ __('Compressing the video in the background…', 'glpimod') }}</span>
                                        <span class="ms-auto fw-bold" id="glpimod_compress_percent">{{ compression.percent }}%</span>
                                    </div>
                                    <div class="progress progress-sm">
                                        <div class="progress-bar" id="glpimod_compress_bar" style="width: {{ compression.percent }}%"></div>
                                    </div>
                                    <div class="form-hint mt-1">{{ __('You can leave this page; the login page keeps the current video until it finishes.', 'glpimod') }}</div>
                                </div>
                            {% else %}
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge bg-green-lt"><i class="ti ti-movie me-1"></i>{{ __('Video uploaded', 'glpimod') }} · {{ video.size_label }}</span>
                                    {% if ffmpeg_available %}
                                        <button type="submit" name="compress_video" value="1" class="btn btn-sm {{ video_warning ? 'btn-primary' : 'btn-outline-primary' }}"
                                                onclick="return confirm('{{ __('Compress the background video? It runs in the background and replaces the video only if the result is smaller.', 'glpimod')|e('js') }}');">
                                            <i class="ti ti-arrows-minimize me-1"></i>{{ __('Compress', 'glpimod') }}
                                        </button>
                                    {% endif %}
                                    <button type="submit" name="delete_resource" value="background_video" class="btn btn-sm btn-ghost-danger"
                                            onclick="return confirm('{{ __('Remove the background video? The login page will use the background image.', 'glpimod')|e('js') }}');">
                                        <i class="ti ti-trash me-1"></i>{{ __('Remove video', 'glpimod') }}
                                    </button>
                                </div>
                                {% if video_warning %}
                                    <div class="alert alert-warning py-2 mb-2">
                                        <i class="ti ti-alert-triangle me-1"></i>
                                        {% if ffmpeg_available %}
                                            {{ __('The video is larger than %s. Every visitor downloads it when opening the login page: use "Compress" to reduce it.', 'glpimod')|format(video_warning_label) }}
                                        {% else %}
                                            {{ __('The video is larger than %s. Every visitor downloads it when opening the login page; compress it (for example 1080p, 20-30 seconds, H.264) for a faster login.', 'glpimod')|format(video_warning_label) }}
                                        {% endif %}
                                    </div>
                                {% endif %}
                                {% if not ffmpeg_available %}
                                    <div class="border rounded-3 p-2 mb-2 small">
                                        {% if ffmpeg_status == 'installing' %}
                                            <span class="spinner-border spinner-border-sm text-primary me-1"></span>
                                            {{ __('Preparing the video compressor in the background (downloading ffmpeg). Reload this page in a minute.', 'glpimod') }}
                                        {% elseif ffmpeg_status == 'unsupported' %}
                                            <i class="ti ti-info-circle me-1"></i>
                                            {{ __('The video compressor is not available: this server does not allow PHP to run external programs (exec).', 'glpimod') }}
                                        {% else %}
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <span>
                                                    <i class="ti ti-tool me-1"></i>
                                                    {% if ffmpeg_status == 'failed' %}
                                                        {{ __('The video compressor could not be downloaded (the server needs Internet access).', 'glpimod') }}
                                                    {% else %}
                                                        {{ __('The video compressor (ffmpeg) is not installed yet.', 'glpimod') }}
                                                    {% endif %}
                                                </span>
                                                <button type="submit" name="install_ffmpeg" value="1" class="btn btn-sm btn-outline-primary">
                                                    <i class="ti ti-download me-1"></i>{{ ffmpeg_status == 'failed' ? __('Retry', 'glpimod') : __('Install compressor', 'glpimod') }}
                                                </button>
                                            </div>
                                            <div class="form-hint mt-1">{{ __('Alternatively, install it on the server:', 'glpimod') }} <code>sudo apt install ffmpeg</code></div>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% else %}
                            <div class="form-hint mb-2">{{ __('No video uploaded: the login page uses the background image.', 'glpimod') }}</div>
                        {% endif %}
                        {{ ui.upload('background_video', 'video/mp4', __('MP4 (H.264), 1920×1080 recommended, ideally under 10 MB.', 'glpimod') ~ ' ' ~ __('Server upload limit: %s.', 'glpimod')|format(max_upload), 'glpimod_preview_video') }}

                        <div class="glpimod-section-title mt-4 mb-2">{{ __('Background image', 'glpimod') }}</div>
                        <div class="form-hint mb-2">{{ __('Used when there is no video, and while the video loads.', 'glpimod') }}</div>
                        {{ ui.upload('background', 'image/jpeg', __('JPG, 1920×1080 recommended.', 'glpimod'), 'glpimod_preview_bg') }}
                    </div>

                    <div class="col-xl-6">
                        <div class="glpimod-section-title mb-2">{{ __('Preview', 'glpimod') }}</div>
                        <div class="glpimod-preview" id="glpimod_preview_bg" style="background-image:url('{{ bg_url }}');">
                            <video id="glpimod_preview_video" muted loop autoplay playsinline
                                   {% if video.exists %}src="{{ video_url }}"{% else %}hidden{% endif %}></video>
                            <div class="glpimod-box" id="glpimod_preview_box" style="background-color:rgba(255,255,255,{{ login_opacity|default('0.65') }});">
                                <img src="{{ logo_l_url }}" alt=""/>
                                <div class="glpimod-fake-input"></div>
                                <div class="glpimod-fake-input"></div>
                                <div class="glpimod-fake-btn"></div>
                            </div>
                        </div>
                        <div class="form-hint mt-2">{{ __('Approximate preview. Changes are applied when you save.', 'glpimod') }}</div>
                    </div>
                </div>
            </div>

            {# ================= TAB: logos ================= #}
            <div class="tab-pane" id="glpimod-tab-logos" role="tabpanel">
                {{ ui.switch('show_custom_logos', show_custom_logos, __('Use custom logos', 'glpimod'), __('If disabled, the original GLPI logos are restored. Uploaded files are kept.', 'glpimod')) }}

                {% for key, logo in logos %}
                    <div class="border rounded-3 p-3 mt-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-lg-4">
                                <div class="fw-bold">{{ logo.label }} <span class="text-muted fw-normal small">· PNG {{ logo.hint }}</span></div>
                                <div class="text-muted small mb-2">{{ logo.where }}</div>
                                {{ ui.upload(key, 'image/png', '', 'glpimod_' ~ key ~ '_main') }}
                            </div>
                            <div class="col-6 col-lg-4">
                                <div class="glpimod-tile light"><img id="glpimod_{{ key }}_main" src="{{ preview_url }}?resource={{ key }}&v={{ logo.info.version }}" alt=""/></div>
                                <div class="text-center small text-muted mt-1">{{ __('Main logo on light background', 'glpimod') }}</div>
                            </div>
                            <div class="col-6 col-lg-4">
                                <div class="glpimod-tile dark"><img src="{{ preview_url }}?resource={{ key }}&v={{ logo.info.version }}" alt=""/></div>
                                <div class="text-center small text-muted mt-1">{{ __('Main logo on dark background', 'glpimod') }}</div>
                            </div>
                        </div>

                        <details class="mt-3" {{ logo.has_variants ? 'open' : '' }}>
                            <summary class="small fw-bold text-primary" style="cursor:pointer;">
                                <i class="ti ti-palette me-1"></i>{{ __('Logos by colour (optional)', 'glpimod') }}
                                {% if logo.has_variants %}<span class="badge bg-blue-lt ms-1">{{ __('in use', 'glpimod') }}</span>{% endif %}
                            </summary>
                            <div class="form-hint mb-2">{{ __('GLPI uses a different version of the logo depending on the background. Upload one only if the main logo does not look good there.', 'glpimod') }}</div>
                            <div class="row g-3">
                                {% for variant, v in logo.variants %}
                                    <div class="col-md-4">
                                        <div class="glpimod-tile {{ v.bg }}">
                                            <img id="glpimod_{{ key }}__{{ variant }}_img" src="{{ preview_url }}?resource={{ key }}&variant={{ variant }}&v={{ v.info.version }}" alt=""/>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between mt-1 mb-1">
                                            <span class="small fw-bold">{{ v.label }}</span>
                                            {% if v.custom %}
                                                <span class="badge bg-blue-lt">{{ __('Own file', 'glpimod') }}</span>
                                            {% else %}
                                                <span class="badge bg-secondary-lt">{{ __('Uses main logo', 'glpimod') }}</span>
                                            {% endif %}
                                        </div>
                                        {{ ui.upload(key ~ '__' ~ variant, 'image/png', '', 'glpimod_' ~ key ~ '__' ~ variant ~ '_img') }}
                                        {% if v.custom %}
                                            <button type="submit" name="delete_resource" value="{{ key }}__{{ variant }}" class="btn btn-sm btn-ghost-danger mt-1"
                                                    onclick="return confirm('{{ __('Remove this colour-specific logo and use the main logo instead?', 'glpimod')|e('js') }}');">
                                                <i class="ti ti-arrow-back-up me-1"></i>{{ __('Use main logo', 'glpimod') }}
                                            </button>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        </details>
                    </div>
                {% endfor %}
            </div>
            {# ================= TAB: self-service portal ================= #}
            <div class="tab-pane" id="glpimod-tab-helpdesk" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-5">
                        <div class="glpimod-section-title mb-2">{{ __('Clock', 'glpimod') }}</div>
                        {{ ui.switch('helpdesk_clock', helpdesk.clock, __('Show the real time on the clock of the illustration', 'glpimod'), __('Replaces the fixed "9:00" with the current time of each user\'s device.', 'glpimod')) }}
                        <div class="d-flex align-items-center gap-3 mt-2 ms-5">
                            <label class="form-check form-check-inline mb-0">
                                <input class="form-check-input glpimod-hd" type="radio" name="clock_format" value="12" {{ helpdesk.clock_format != '24' ? 'checked' : '' }}/>
                                <span class="form-check-label">{{ __('12 hours (4:35)', 'glpimod') }}</span>
                            </label>
                            <label class="form-check form-check-inline mb-0">
                                <input class="form-check-input glpimod-hd" type="radio" name="clock_format" value="24" {{ helpdesk.clock_format == '24' ? 'checked' : '' }}/>
                                <span class="form-check-label">{{ __('24 hours (16:35)', 'glpimod') }}</span>
                            </label>
                        </div>

                        <div class="glpimod-section-title mt-4 mb-2">{{ __('Seasonal themes', 'glpimod') }}</div>
                        <select class="form-select glpimod-hd" name="season" id="glpimod_season">
                            <option value="none" {{ helpdesk.season == 'none' ? 'selected' : '' }}>{{ __('Off', 'glpimod') }}</option>
                            <option value="auto" {{ helpdesk.season == 'auto' ? 'selected' : '' }}>{{ __('Automatic: follows the calendar of celebrations', 'glpimod') }}</option>
                            {% for group, group_label in helpdesk_groups %}
                                <optgroup label="{{ __('Fixed theme (every day)', 'glpimod') }} · {{ group_label }}">
                                    {% for id, theme in helpdesk_themes|filter(t => t.group == group) %}
                                        <option value="{{ id }}" {{ helpdesk.season == id ? 'selected' : '' }}>{{ theme.label }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                        <div class="mt-2 small" id="glpimod_season_status"
                             data-themes="{{ helpdesk_themes|json_encode|e('html_attr') }}"
                             data-today="{{ __('Today: %s', 'glpimod') }}"
                             data-none="{{ __('Today: no celebration · next: %1$s, from %2$s', 'glpimod') }}"
                             data-always="{{ __('Active every day', 'glpimod') }}"></div>

                        <div id="glpimod_calendar" class="mt-3">
                            <div class="form-hint mb-1">{{ __('Celebrations included in the automatic calendar:', 'glpimod') }}</div>
                            <div class="border rounded-3 px-3 py-2" style="max-height:320px; overflow:auto;">
                                {% for group, group_label in helpdesk_groups %}
                                    <div class="glpimod-section-title {{ loop.first ? '' : 'mt-2' }} mb-1">{{ group_label }}</div>
                                    {% for id, theme in helpdesk_themes|filter(t => t.group == group) %}
                                        <label class="form-check mb-1">
                                            <input class="form-check-input glpimod-hd" type="checkbox" name="seasons[]" value="{{ id }}" {{ id in helpdesk.seasons ? 'checked' : '' }}/>
                                            <span class="form-check-label">{{ theme.label }} <span class="text-muted small">· {{ theme.dates }}</span></span>
                                        </label>
                                    {% endfor %}
                                {% endfor %}
                            </div>
                        </div>

                        <div id="glpimod_effects" class="mt-3 ms-1">
                            <div class="form-hint mb-2">{{ __('Effects of the themes:', 'glpimod') }}</div>
                            {% for key, item in {
                                'fx_decor': [__('Decoration on the illustration', 'glpimod'), helpdesk.effects.decor],
                                'fx_top': [__('Garland, pennants or lights along the top', 'glpimod'), helpdesk.effects.lights],
                                'fx_particles': [__('Animated effect (snow, confetti, petals, hearts...)', 'glpimod'), helpdesk.effects.snow]
                            } %}
                                <input type="hidden" name="{{ key }}" value="0"/>
                                <label class="form-check mb-1">
                                    <input class="form-check-input glpimod-hd" type="checkbox" name="{{ key }}" value="1" {{ item[1] ? 'checked' : '' }}/>
                                    <span class="form-check-label">{{ item[0] }}</span>
                                </label>
                            {% endfor %}
                            <div class="form-hint mt-2">{{ __('Animations are disabled for users who ask their system to reduce motion.', 'glpimod') }}</div>
                        </div>
                        <div class="form-hint mt-3">
                            <i class="ti ti-info-circle me-1"></i>{{ __('The clock and the furniture decoration apply to the default illustrations of the portal. If an entity uses other illustrations, only the lights and the snowfall are shown.', 'glpimod') }}
                        </div>
                    </div>
                    <div class="col-xl-7">
                        <div class="glpimod-section-title mb-2">{{ __('Preview', 'glpimod') }}</div>
                        <div class="glpimod-hd-preview" id="glpimod_hd_preview">
                            <div class="scene scene-left">{{ render_scene('shelves') }}</div>
                            <div class="glpimod-hd-title">{{ __('How can we help you?', 'glpimod') }}<div class="glpimod-hd-search"></div></div>
                            <div class="scene scene-right">{{ render_scene('desk') }}</div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2" id="glpimod_preview_theme_box">
                            <label class="small text-muted text-nowrap mb-0" for="glpimod_preview_theme">{{ __('Show in the preview:', 'glpimod') }}</label>
                            <select class="form-select form-select-sm" id="glpimod_preview_theme">
                                {% for group, group_label in helpdesk_groups %}
                                    <optgroup label="{{ group_label }}">
                                        {% for id, theme in helpdesk_themes|filter(t => t.group == group) %}
                                            <option value="{{ id }}">{{ theme.label }}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            {# ================= TAB: texts ================= #}
            <div class="tab-pane" id="glpimod-tab-texts" role="tabpanel">
                <input type="hidden" name="texts_lang" value="{{ texts_lang }}"/>

                {# ----- Tiles of the self-service home page ----- #}
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <div class="glpimod-section-title me-auto">{{ __('Tiles of the self-service home page', 'glpimod') }}</div>
                    {% if tiles_suggestions %}
                        <button type="button" class="btn btn-sm btn-outline-primary" id="glpimod_tiles_all">
                            <i class="ti ti-wand me-1"></i>{{ __('Use all the suggestions', 'glpimod') }}
                        </button>
                    {% endif %}
                </div>
                <div class="form-hint mb-3">{{ __('GLPI saves these texts in the database when it creates the tiles, in the language used at that moment, so the language files do not translate them. Edit them here; the changes apply to everyone.', 'glpimod') }}</div>

                {% if tiles is empty %}
                    <div class="alert alert-info mb-4">{{ __('No tiles found (GLPI 11 or later is needed).', 'glpimod') }}</div>
                {% else %}
                    <div class="table-responsive mb-2">
                        <table class="table table-sm table-vcenter mb-0">
                            <thead>
                                <tr>
                                    <th style="width:18%">{{ __('Tile', 'glpimod') }}</th>
                                    <th style="width:30%">{{ __('Title') }}</th>
                                    <th>{{ __('Description') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for tile in tiles %}
                                    {% set base = 'tiles[' ~ tile.type ~ '][' ~ tile.id ~ ']' %}
                                    <tr class="glpimod-tile-row{{ tile.has_suggestion ? ' table-warning' : '' }}"
                                        data-title="{{ tile.suggested_title ?? '' }}" data-description="{{ tile.suggested_description ?? '' }}">
                                        <td>
                                            <span class="badge bg-blue-lt">{{ tile.label }}</span>
                                            {% for owner in tile.owners %}<div class="small text-muted text-truncate" title="{{ owner }}">{{ owner }}</div>{% endfor %}
                                            {% if tile.has_suggestion %}
                                                <button type="button" class="btn btn-sm btn-link px-0 glpimod-tile-use">
                                                    <i class="ti ti-wand me-1"></i>{{ __('Use suggestion', 'glpimod') }}
                                                </button>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" name="{{ base }}[title]" value="{{ tile.title }}" maxlength="255"/>
                                            {% if tile.suggested_title %}<div class="form-hint">{{ __('Suggestion:', 'glpimod') }} {{ tile.suggested_title }}</div>{% endif %}
                                        </td>
                                        <td>
                                            <textarea class="form-control form-control-sm" rows="2" name="{{ base }}[description]">{{ tile.description }}</textarea>
                                            {% if tile.suggested_description %}<div class="form-hint">{{ __('Suggestion:', 'glpimod') }} {{ tile.suggested_description }}</div>{% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="form-hint mb-4">
                        <i class="ti ti-info-circle me-1"></i>{{ __('Form tiles show the name and description of the form: changing them here also changes them in the service catalog. If a tile has a translation for the user language (Setup > General > Helpdesk translations), that translation is shown instead.', 'glpimod') }}
                    </div>
                {% endif %}

                {# ----- GLPI core strings ----- #}
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <div class="glpimod-section-title me-auto">{{ __('GLPI interface texts', 'glpimod') }}</div>
                    <label class="small text-muted mb-0" for="glpimod_texts_lang">{{ __('Language') }}</label>
                    <select class="form-select form-select-sm w-auto" id="glpimod_texts_lang">
                        {% for code, name in texts_languages %}
                            <option value="{{ code }}" {{ code == texts_lang ? 'selected' : '' }}>{{ name }} ({{ code }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-hint mb-3">{{ __('Replace any text of GLPI that is untranslated or badly translated. The changes are kept apart from GLPI, so they survive its updates, and stop applying if the plugin is disabled.', 'glpimod') }}</div>

                {% if override_suggestions|length %}
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" id="glpimod_override_suggestions">
                        <div class="me-auto">
                            <b>{{ __('Suggested corrections', 'glpimod') }}</b>:
                            {{ __('the GLPI translation has texts that do not fit this language (for example the "voseo": "Solicitá", "Usá").', 'glpimod') }}
                        </div>
                        <button type="button" class="btn btn-sm btn-warning" id="glpimod_override_suggest_btn"
                                data-rows="{{ override_suggestions|json_encode|e('html_attr') }}">
                            <i class="ti ti-wand me-1"></i>{{ __('Add %d corrections', 'glpimod')|format(override_suggestions|length) }}
                        </button>
                    </div>
                {% endif %}

                <div class="input-group input-group-sm mb-2" style="max-width:640px;">
                    <span class="input-group-text"><i class="ti ti-search"></i></span>
                    <input type="text" class="form-control" id="glpimod_texts_search" autocomplete="off"
                           placeholder="{{ __('Search a text as you see it in GLPI (in English or in the translation)...', 'glpimod') }}"
                           data-url="{{ texts_search_url }}" data-lang="{{ texts_lang }}"/>
                </div>
                <div id="glpimod_texts_results" class="list-group mb-3" style="max-height:280px; overflow:auto;" hidden></div>

                <table class="table table-sm table-vcenter" id="glpimod_overrides"
                       data-empty="{{ __('No custom texts yet: search for a text above to change it.', 'glpimod') }}"
                       data-remove="{{ __('Remove', 'glpimod') }}" data-singular="{{ __('Singular', 'glpimod') }}" data-plural="{{ __('Plural', 'glpimod') }}"
                       data-none="{{ __('(untranslated)', 'glpimod') }}" data-noresults="{{ __('No texts found', 'glpimod') }}"
                       data-add="{{ __('Change', 'glpimod') }}" data-added="{{ __('Already in the list', 'glpimod') }}">
                    <thead>
                        <tr>
                            <th style="width:30%">{{ __('Original text (English)', 'glpimod') }}</th>
                            <th style="width:30%">{{ __('Current GLPI translation', 'glpimod') }}</th>
                            <th>{{ __('Your text', 'glpimod') }}</th>
                            <th style="width:1%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in overrides %}
                            <tr data-key="{{ row.key64 }}">
                                <td>
                                    <input type="hidden" name="overrides[{{ loop.index0 }}][key]" value="{{ row.key64 }}"/>
                                    {% if row.context %}<span class="badge bg-secondary-lt me-1">{{ row.context }}</span>{% endif %}{{ row.english|join(' / ') }}
                                </td>
                                <td class="text-muted">{{ row.translation is empty ? __('(untranslated)', 'glpimod') : row.translation|join(' / ') }}</td>
                                <td>
                                    {% set row_index = loop.index0 %}
                                    {% for i in 0..(max(row.forms, row.custom|length) - 1) %}
                                        <input type="text" class="form-control form-control-sm{{ not loop.first ? ' mt-1' : '' }}" name="overrides[{{ row_index }}][forms][]"
                                               value="{{ row.custom[i] ?? '' }}" {% if row.plural %}placeholder="{{ i == 0 ? __('Singular', 'glpimod') : __('Plural', 'glpimod') ~ ' ' ~ i }}"{% endif %}/>
                                    {% endfor %}
                                </td>
                                <td>
                                    <label class="form-check mb-0" title="{{ __('Remove', 'glpimod') }}">
                                        <input class="form-check-input" type="checkbox" name="overrides[{{ loop.index0 }}][delete]" value="1"/>
                                        <i class="ti ti-trash text-danger"></i>
                                    </label>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="form-hint">
                    <i class="ti ti-info-circle me-1"></i>{{ __('Changes apply when you press Save. Texts of other plugins are not included.', 'glpimod') }}
                </div>
            </div>
        </div>

        <div class="card-footer d-flex align-items-center gap-2 position-sticky bottom-0 bg-body" style="z-index:5;">
            <span class="text-muted small me-auto">
                <i class="ti ti-info-circle me-1"></i>{{ __('Logos and favicon may need a hard refresh (Ctrl+F5) to show up.', 'glpimod') }}
            </span>
            <button class="btn btn-primary" type="submit" name="update" value="1">
                <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Save') }}
            </button>
        </div>
    </div>
</form>

<link rel="stylesheet" href="{{ plugin_url }}/css/glpimod_helpdesk.css?v={{ version }}"/>
<script src="{{ plugin_url }}/public/helpdesk_scene.js?v={{ version }}"></script>
<script>
(function () {
    'use strict';
    const form = document.getElementById('glpimod-form');
    if (!form) return;

    // Keep the selected tab after saving (page reloads)
    const tabKey = 'glpimod_active_tab';
    form.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function (link) {
        link.addEventListener('shown.bs.tab', function () {
            try { sessionStorage.setItem(tabKey, link.getAttribute('href')); } catch (e) {}
        });
    });
    try {
        const saved = sessionStorage.getItem(tabKey);
        const link = saved ? form.querySelector('a[href="' + saved + '"]') : null;
        if (link && window.bootstrap && bootstrap.Tab) { bootstrap.Tab.getOrCreateInstance(link).show(); }
    } catch (e) {}

    // Live opacity
    const slider = document.getElementById('glpimod_opacity');
    const value = document.getElementById('glpimod_opacity_value');
    const box = document.getElementById('glpimod_preview_box');
    if (slider) {
        slider.addEventListener('input', function () {
            const opacity = parseFloat(this.value);
            value.textContent = opacity.toFixed(2);
            box.style.backgroundColor = 'rgba(255,255,255,' + opacity + ')';
        });
    }

    // Live title
    const title = document.getElementById('glpimod_title');
    const titlePreview = document.getElementById('glpimod_title_preview');
    if (title) {
        title.addEventListener('input', function () { titlePreview.textContent = this.value; });
    }

    // Background video compression progress
    const compress = document.getElementById('glpimod_compress');
    if (compress) {
        const bar = document.getElementById('glpimod_compress_bar');
        const percent = document.getElementById('glpimod_compress_percent');
        const timer = setInterval(function () {
            fetch(compress.dataset.statusUrl, {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
                .then(function (r) { return r.json(); })
                .then(function (status) {
                    if (status.state === 'running') {
                        bar.style.width = status.percent + '%';
                        percent.textContent = status.percent + '%';
                    } else {
                        clearInterval(timer);
                        window.location.reload();
                    }
                })
                .catch(function () {});
        }, 2000);
    }

    // Self-service portal preview
    const hdPreview = document.getElementById('glpimod_hd_preview');
    const status = document.getElementById('glpimod_season_status');
    const previewTheme = document.getElementById('glpimod_preview_theme');
    const themes = status ? JSON.parse(status.dataset.themes || '{}') : {};
    const scene = window.GlpimodHelpdeskScene;
    const fmtDate = function (d) {
        try { return d.toLocaleDateString(document.documentElement.lang || undefined, {day: 'numeric', month: 'long'}); } catch (e) { return d.toDateString(); }
    };
    const fmt = function (text) { const args = [].slice.call(arguments, 1); let i = 0; return text.replace(/%(\d\$)?s/g, function (m, n) { return n ? args[parseInt(n, 10) - 1] : args[i++]; }); };
    const label = function (id) { return themes[id] ? themes[id].label + ' (' + themes[id].dates + ')' : id; };

    function hdConfig() {
        const season = form.querySelector('select[name="season"]').value;
        const enabled = [].map.call(form.querySelectorAll('input[name="seasons[]"]:checked'), function (i) { return i.value; });
        document.getElementById('glpimod_calendar').hidden = season !== 'auto';
        document.getElementById('glpimod_effects').hidden = season === 'none';
        document.getElementById('glpimod_preview_theme_box').hidden = season === 'none';

        // real state today
        status.hidden = season === 'none';
        if (scene && season === 'auto') {
            const today = scene.activeTheme(new Date(), enabled);
            const next = scene.nextTheme(new Date(), enabled);
            status.textContent = today ? fmt(status.dataset.today, label(today))
                : (next ? fmt(status.dataset.none, themes[next.id] ? themes[next.id].label : next.id, fmtDate(next.start)) : '');
        } else if (season !== 'none') {
            status.textContent = status.dataset.always;
        }
        return {
            clock: !!form.querySelector('input[type=checkbox][name="helpdesk_clock"]:checked'),
            clock_format: (form.querySelector('[name="clock_format"]:checked') || {}).value || '12',
            season: season,
            seasons: enabled,
            effects: {
                decor: !!form.querySelector('input[type=checkbox][name="fx_decor"]:checked'),
                lights: !!form.querySelector('input[type=checkbox][name="fx_top"]:checked'),
                snow: !!form.querySelector('input[type=checkbox][name="fx_particles"]:checked'),
            },
        };
    }
    if (hdPreview && scene && previewTheme) {
        // default theme shown in the preview: the fixed one, today's one, or the next one
        (function () {
            const season = form.querySelector('select[name="season"]').value;
            const enabled = [].map.call(form.querySelectorAll('input[name="seasons[]"]:checked'), function (i) { return i.value; });
            const today = scene.activeTheme(new Date(), enabled), next = scene.nextTheme(new Date(), enabled);
            previewTheme.value = season !== 'none' && season !== 'auto' ? season : (today || (next && next.id) || 'christmas');
        })();
        const refresh = function () {
            const config = hdConfig();
            if (config.season !== 'none' && config.season !== 'auto') previewTheme.value = config.season;
            // the preview always shows the chosen theme, whatever the date
            scene.render(hdPreview, Object.assign({}, config, {season: config.season === 'none' ? 'none' : previewTheme.value}));
        };
        form.querySelectorAll('.glpimod-hd, input[type=checkbox][name="helpdesk_clock"]').forEach(function (input) {
            input.addEventListener('change', refresh);
        });
        previewTheme.addEventListener('change', refresh);
        refresh();
    }

    // ----- Texts tab
    const tilesAll = document.getElementById('glpimod_tiles_all');
    const useTile = function (row) {
        if (row.dataset.title) row.querySelector('input[name$="[title]"]').value = row.dataset.title;
        if (row.dataset.description) row.querySelector('textarea[name$="[description]"]').value = row.dataset.description;
        row.classList.remove('table-warning');
        row.classList.add('table-success');
    };
    form.querySelectorAll('.glpimod-tile-use').forEach(function (btn) {
        btn.addEventListener('click', function () { useTile(btn.closest('tr')); });
    });
    if (tilesAll) {
        tilesAll.addEventListener('click', function () {
            form.querySelectorAll('.glpimod-tile-row').forEach(function (row) {
                if (row.dataset.title || row.dataset.description) useTile(row);
            });
        });
    }

    const langSelect = document.getElementById('glpimod_texts_lang');
    if (langSelect) {
        langSelect.addEventListener('change', function () {
            try { sessionStorage.setItem(tabKey, '#glpimod-tab-texts'); } catch (e) {}
            const url = new URL(window.location.href);
            url.searchParams.set('texts_lang', this.value);
            window.location.href = url.toString();
        });
    }

    const table = document.getElementById('glpimod_overrides');
    if (table) {
        const tbody = table.querySelector('tbody');
        let counter = tbody.rows.length;
        const el = function (tag, attrs, text) {
            const node = document.createElement(tag);
            Object.keys(attrs || {}).forEach(function (k) { node.setAttribute(k, attrs[k]); });
            if (text !== undefined) node.textContent = text;
            return node;
        };
        const hasKey = function (key) {
            return [].some.call(tbody.rows, function (r) { return r.dataset.key === key; });
        };
        const emptyRow = function () {
            const old = tbody.querySelector('.glpimod-empty');
            const real = [].filter.call(tbody.rows, function (r) { return !r.classList.contains('glpimod-empty'); }).length;
            if (!real && !old) {
                const tr = el('tr', {'class': 'glpimod-empty'});
                tr.appendChild(el('td', {colspan: '4', 'class': 'text-muted'}, table.dataset.empty));
                tbody.appendChild(tr);
            } else if (real && old) {
                old.remove();
            }
        };
        const addRow = function (item, custom) {
            if (hasKey(item.key64)) return null;
            const i = counter++;
            const tr = el('tr', {'data-key': item.key64, 'class': 'table-success'});
            const td1 = el('td');
            td1.appendChild(el('input', {type: 'hidden', name: 'overrides[' + i + '][key]', value: item.key64}));
            if (item.context) td1.appendChild(el('span', {'class': 'badge bg-secondary-lt me-1'}, item.context));
            td1.appendChild(document.createTextNode(item.english.join(' / ')));
            const td2 = el('td', {'class': 'text-muted'}, item.translation.length ? item.translation.join(' / ') : table.dataset.none);
            const td3 = el('td');
            const forms = Math.max(item.forms || 1, (custom || []).length);
            for (let f = 0; f < forms; f++) {
                const input = el('input', {type: 'text', 'class': 'form-control form-control-sm' + (f ? ' mt-1' : ''), name: 'overrides[' + i + '][forms][]'});
                input.value = (custom && custom[f]) || item.translation[f] || '';
                if (item.plural) input.placeholder = f ? table.dataset.plural + ' ' + f : table.dataset.singular;
                td3.appendChild(input);
            }
            const td4 = el('td');
            const remove = el('button', {type: 'button', 'class': 'btn btn-sm btn-ghost-danger', title: table.dataset.remove});
            remove.appendChild(el('i', {'class': 'ti ti-x'}));
            remove.addEventListener('click', function () { tr.remove(); emptyRow(); });
            td4.appendChild(remove);
            [td1, td2, td3, td4].forEach(function (td) { tr.appendChild(td); });
            tbody.appendChild(tr);
            emptyRow();
            return td3.querySelector('input');
        };
        emptyRow();

        const suggest = document.getElementById('glpimod_override_suggest_btn');
        if (suggest) {
            suggest.addEventListener('click', function () {
                JSON.parse(suggest.dataset.rows || '[]').forEach(function (row) { addRow(row, row.custom); });
                document.getElementById('glpimod_override_suggestions').hidden = true;
            });
        }

        const search = document.getElementById('glpimod_texts_search');
        const results = document.getElementById('glpimod_texts_results');
        let timer = null, seq = 0;
        if (search) {
            search.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
            search.addEventListener('input', function () {
                clearTimeout(timer);
                const q = this.value.trim();
                if (q.length < 3) { results.hidden = true; results.textContent = ''; return; }
                timer = setTimeout(function () {
                    const mine = ++seq;
                    const url = new URL(search.dataset.url, window.location.href);
                    url.searchParams.set('lang', search.dataset.lang);
                    url.searchParams.set('q', q);
                    fetch(url.toString(), {credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}})
                        .then(function (r) { return r.json(); })
                        .then(function (items) {
                            if (mine !== seq) return;
                            results.textContent = '';
                            results.hidden = false;
                            if (!items.length) {
                                results.appendChild(el('div', {'class': 'list-group-item text-muted small'}, table.dataset.noresults));
                                return;
                            }
                            items.forEach(function (item) {
                                const line = el('div', {'class': 'list-group-item list-group-item-action d-flex align-items-center gap-2 py-1'});
                                const text = el('div', {'class': 'me-auto small'});
                                if (item.context) text.appendChild(el('span', {'class': 'badge bg-secondary-lt me-1'}, item.context));
                                text.appendChild(el('b', {}, item.english.join(' / ')));
                                text.appendChild(el('div', {'class': 'text-muted'}, item.translation.length ? item.translation.join(' / ') : table.dataset.none));
                                const btn = el('button', {type: 'button', 'class': 'btn btn-sm btn-outline-primary'}, hasKey(item.key64) ? table.dataset.added : table.dataset.add);
                                btn.disabled = hasKey(item.key64);
                                btn.addEventListener('click', function () {
                                    const input = addRow(item);
                                    btn.disabled = true;
                                    btn.textContent = table.dataset.added;
                                    if (input) { input.focus(); input.select(); }
                                });
                                line.appendChild(text);
                                line.appendChild(btn);
                                results.appendChild(line);
                            });
                        })
                        .catch(function () {});
                }, 300);
            });
        }
    }

    // Preview selected files before saving
    form.querySelectorAll('input.glpimod-upload[data-preview]').forEach(function (input) {
        input.addEventListener('change', function () {
            const file = this.files && this.files[0];
            const target = document.getElementById(this.dataset.preview);
            if (!file || !target) return;
            const url = URL.createObjectURL(file);
            if (target.tagName === 'VIDEO') {
                target.hidden = false;
                target.src = url;
                target.play().catch(function () {});
            } else if (target.tagName === 'IMG') {
                target.src = url;
            } else {
                target.style.backgroundImage = 'url(' + url + ')';
            }
        });
    });
})();
</script>
