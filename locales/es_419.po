msgid "GLPI Mod - Branding"
msgstr "GLPI Mod - Imagen de marca"

msgid "Please activate the plugin"
msgstr "Por favor active el plugin"

msgid "the file exceeds the maximum upload size of the server"
msgstr "el archivo supera el tamaño máximo de subida del servidor"

msgid "invalid file"
msgstr "archivo no válido"

msgid "Upload of %1$s failed: %2$s"
msgstr "No se pudo subir %1$s: %2$s"

msgid "%1$s was rejected: only %2$s files are accepted"
msgstr "%1$s fue rechazado: solo se aceptan archivos %2$s"

msgid "%1$s was rejected: its content (%2$s) does not match the .%3$s extension"
msgstr "%1$s fue rechazado: su contenido (%2$s) no corresponde a la extensión .%3$s"

msgid "could not be saved"
msgstr "no se pudo guardar"

msgid "GLPI page"
msgstr "Página de GLPI"

msgid "External link"
msgstr "Enlace externo"

msgid "Form"
msgstr "Formulario"

msgid "Preparing the video compressor in the background. It takes about a minute."
msgstr "Preparando el compresor de video en segundo plano. Tarda alrededor de un minuto."

msgid "The video compressor could not be prepared."
msgstr "No se pudo preparar el compresor de video."

msgid "Compressing the background video in the background. You can keep working; the login page keeps the current video until it finishes."
msgstr "Comprimiendo el video de fondo en segundo plano. Puedes seguir trabajando; el inicio de sesión mantiene el video actual hasta que termine."

msgid "The video compression could not be started."
msgstr "No se pudo iniciar la compresión del video."

msgid "The video is being compressed: wait for it to finish before uploading another one."
msgstr "El video se está comprimiendo: espera a que termine antes de cambiarlo."

msgid "Background video uploaded"
msgstr "Video de fondo cargado"

msgid "%d texts of the self-service portal updated"
msgstr "Se actualizaron %d textos del portal de autoservicio"

msgid "The custom texts could not be saved: check the permissions of the files folder of GLPI."
msgstr "No se pudieron guardar los textos personalizados: revise los permisos de la carpeta files de GLPI."

msgid "Custom GLPI texts saved for %1$s: %2$d"
msgstr "Textos personalizados de GLPI guardados para %1$s: %2$d"

msgid "Configuration saved"
msgstr "Configuración guardada"

msgid "Background video removed: the login page now uses the background image"
msgstr "Video de fondo eliminado: el inicio de sesión ahora usa la imagen de fondo"

msgid "Colour-specific logo removed: the main logo is used instead"
msgstr "Logo por color eliminado: se usa el logo principal"

msgid "Hay Festival and Cartagena Music Festival"
msgstr "Hay Festival y Festival de Música de Cartagena"

msgid "7 – 31 January"
msgstr "7 – 31 de enero"

msgid "Fiestas de la Candelaria"
msgstr "Fiestas de la Candelaria"

msgid "30 January – 2 February"
msgstr "30 de enero – 2 de febrero"

msgid "Barranquilla Carnival"
msgstr "Carnaval de Barranquilla"

msgid "the 10 days before Ash Wednesday"
msgstr "los 10 días antes del Miércoles de Ceniza"

msgid "4 – 8 March"
msgstr "4 – 8 de marzo"

msgid "Holy Week (rest week)"
msgstr "Semana Santa (semana de descanso)"

msgid "Palm Sunday to Easter Sunday"
msgstr "Domingo de Ramos a Domingo de Resurrección"

msgid "week of the 2nd Sunday of May"
msgstr "semana del 2.º domingo de mayo"

msgid "week of the 3rd Sunday of June"
msgstr "semana del 3.er domingo de junio"

msgid "Independence of Colombia"
msgstr "Independencia de Colombia"

msgid "14 – 20 July"
msgstr "14 – 20 de julio"

msgid "Kite season (Battle of Boyacá)"
msgstr "Temporada de cometas (Batalla de Boyacá)"

msgid "August"
msgstr "agosto"

msgid "Love and Friendship"
msgstr "Amor y Amistad"

msgid "the two weeks up to the 3rd Saturday of September"
msgstr "las dos semanas hasta el 3.er sábado de septiembre"

msgid "24 – 31 October"
msgstr "24 – 31 de octubre"

msgid "Independence of Cartagena"
msgstr "Independencia de Cartagena"

msgid "1 – 15 November"
msgstr "1 – 15 de noviembre"

msgid "Christmas and Día de las Velitas"
msgstr "Navidad y Día de las Velitas"

msgid "1 December – 6 January (candles on 7 and 8 December)"
msgstr "1 de diciembre – 6 de enero (velitas el 7 y 8 de diciembre)"

msgid "10 – 14 February"
msgstr "10 – 14 de febrero"

msgid "14 – 17 March"
msgstr "14 – 17 de marzo"

msgid "Memorial Day"
msgstr "Memorial Day (Día de los Caídos)"

msgid "long weekend of the last Monday of May"
msgstr "fin de semana largo del último lunes de mayo"

msgid "Independence Day (4th of July)"
msgstr "Día de la Independencia (4 de julio)"

msgid "1 – 4 July"
msgstr "1 – 4 de julio"

msgid "Thanksgiving"
msgstr "Día de Acción de Gracias"

msgid "week of the 4th Thursday of November"
msgstr "semana del 4.º jueves de noviembre"

msgid "Small logo"
msgstr "Logo pequeño"

msgid "Collapsed side menu"
msgstr "Menú lateral contraído"

msgid "Medium logo"
msgstr "Logo mediano"

msgid "Side menu and header"
msgstr "Menú lateral y encabezado"

msgid "Large logo"
msgstr "Logo grande"

msgid "Login page"
msgstr "Inicio de sesión"

msgid "For light backgrounds"
msgstr "Para fondos claros"

msgid "For dark backgrounds"
msgstr "Para fondos oscuros"

msgid "User menu"
msgstr "Menú de usuario"

msgid "Colombia and the Caribbean"
msgstr "Colombia y el Caribe"

msgid "United States"
msgstr "Estados Unidos"

msgid "Branding"
msgstr "Imagen de marca"

msgid "Login background"
msgstr "Fondo del login"

msgid "Disabled"
msgstr "Desactivado"

msgid "Video"
msgstr "Video"

msgid "Image"
msgstr "Imagen"

msgid "Logos"
msgstr "Logos"

msgid "Custom"
msgstr "Personalizado"

msgid "Favicon"
msgstr "Favicon"

msgid "Title and favicon"
msgstr "Título y favicon"

msgid "Self-service portal"
msgstr "Portal de autoservicio"

msgid "Texts"
msgstr "Textos"

msgid "Page title"
msgstr "Título de la página"

msgid "Shown in the browser tab and as the application name."
msgstr "Se muestra en la pestaña del navegador y como nombre de la aplicación."

msgid "Use custom favicon"
msgstr "Usar favicon personalizado"

msgid "If disabled, the original GLPI favicon is restored."
msgstr "Si se desactiva, se restaura el favicon original de GLPI."

msgid "ICO file, 16×16 or 32×32 px."
msgstr "Archivo ICO de 16×16 o 32×32 px."

msgid "Preview"
msgstr "Vista previa"

msgid "Customize the login page"
msgstr "Personalizar la página de inicio de sesión"

msgid "Background image or video, and login box transparency."
msgstr "Imagen o video de fondo, y transparencia de la caja de acceso."

msgid "Login box opacity"
msgstr "Opacidad de la caja de acceso"

msgid "Transparent"
msgstr "Transparente"

msgid "Solid"
msgstr "Sólida"

msgid "Background video"
msgstr "Video de fondo"

msgid "optional"
msgstr "opcional"

msgid "Video compressed: %1$s → %2$s. The login page already uses the new version."
msgstr "Video comprimido: %1$s → %2$s. El inicio de sesión ya usa la nueva versión."

msgid "The video was already optimized: compressing it would not make it smaller, so the original was kept."
msgstr "El video ya estaba optimizado: comprimirlo no lo hacía más liviano, así que se conservó el original."

msgid "The video could not be compressed. The original video was kept."
msgstr "No se pudo comprimir el video. Se conservó el video original."

msgid "Compressing the video in the background…"
msgstr "Comprimiendo el video en segundo plano…"

msgid "You can leave this page; the login page keeps the current video until it finishes."
msgstr "Puedes salir de esta página; el inicio de sesión mantiene el video actual hasta que termine."

msgid "Video uploaded"
msgstr "Video cargado"

msgid "Compress the background video? It runs in the background and replaces the video only if the result is smaller."
msgstr "¿Comprimir el video de fondo? Se hace en segundo plano y solo reemplaza el video si el resultado es más liviano."

msgid "Compress"
msgstr "Comprimir"

msgid "Remove the background video? The login page will use the background image."
msgstr "¿Eliminar el video de fondo? El inicio de sesión usará la imagen de fondo."

msgid "Remove video"
msgstr "Quitar video"

msgid "The video is larger than %s. Every visitor downloads it when opening the login page: use \"Compress\" to reduce it."
msgstr "El video pesa más de %s. Cada visitante lo descarga al abrir el inicio de sesión: usa \"Comprimir\" para reducirlo."

msgid "The video is larger than %s. Every visitor downloads it when opening the login page; compress it (for example 1080p, 20-30 seconds, H.264) for a faster login."
msgstr "El video pesa más de %s. Cada visitante lo descarga al abrir el inicio de sesión; comprímelo (por ejemplo 1080p, 20-30 segundos, H.264) para que cargue más rápido."

msgid "Preparing the video compressor in the background (downloading ffmpeg). Reload this page in a minute."
msgstr "Preparando el compresor de video en segundo plano (descargando ffmpeg). Recarga esta página en un minuto."

msgid "The video compressor is not available: this server does not allow PHP to run external programs (exec)."
msgstr "El compresor de video no está disponible: este servidor no permite que PHP ejecute programas externos (exec)."

msgid "The video compressor could not be downloaded (the server needs Internet access)."
msgstr "No se pudo descargar el compresor de video (el servidor necesita acceso a Internet)."

msgid "The video compressor (ffmpeg) is not installed yet."
msgstr "El compresor de video (ffmpeg) aún no está instalado."

msgid "Retry"
msgstr "Reintentar"

msgid "Install compressor"
msgstr "Instalar compresor"

msgid "Alternatively, install it on the server:"
msgstr "También puedes instalarlo en el servidor:"

msgid "No video uploaded: the login page uses the background image."
msgstr "No hay video cargado: el inicio de sesión usa la imagen de fondo."

msgid "MP4 (H.264), 1920×1080 recommended, ideally under 10 MB."
msgstr "MP4 (H.264), se recomienda 1920×1080 y menos de 10 MB."

msgid "Server upload limit: %s."
msgstr "Límite de subida del servidor: %s."

msgid "Background image"
msgstr "Imagen de fondo"

msgid "Used when there is no video, and while the video loads."
msgstr "Se usa cuando no hay video y mientras el video carga."

msgid "JPG, 1920×1080 recommended."
msgstr "JPG, se recomienda 1920×1080."

msgid "Approximate preview. Changes are applied when you save."
msgstr "Vista previa aproximada. Los cambios se aplican al guardar."

msgid "Use custom logos"
msgstr "Usar logos personalizados"

msgid "If disabled, the original GLPI logos are restored. Uploaded files are kept."
msgstr "Si se desactiva, se restauran los logos originales de GLPI. Los archivos cargados se conservan."

msgid "Main logo on light background"
msgstr "Logo principal sobre fondo claro"

msgid "Main logo on dark background"
msgstr "Logo principal sobre fondo oscuro"

msgid "Logos by colour (optional)"
msgstr "Logos por color (opcional)"

msgid "in use"
msgstr "en uso"

msgid "GLPI uses a different version of the logo depending on the background. Upload one only if the main logo does not look good there."
msgstr "GLPI usa una versión distinta del logo según el fondo. Sube una solo si el logo principal no se ve bien en ese fondo."

msgid "Own file"
msgstr "Archivo propio"

msgid "Uses main logo"
msgstr "Usa el logo principal"

msgid "Remove this colour-specific logo and use the main logo instead?"
msgstr "¿Quitar este logo por color y usar el logo principal?"

msgid "Use main logo"
msgstr "Usar logo principal"

msgid "Clock"
msgstr "Reloj"

msgid "Show the real time on the clock of the illustration"
msgstr "Mostrar la hora real en el reloj de la ilustración"

msgid "Replaces the fixed \"9:00\" with the current time of each user's device."
msgstr "Reemplaza el \"9:00\" fijo por la hora actual del dispositivo de cada usuario."

msgid "12 hours (4:35)"
msgstr "12 horas (4:35)"

msgid "24 hours (16:35)"
msgstr "24 horas (16:35)"

msgid "Seasonal themes"
msgstr "Temporadas"

msgid "Off"
msgstr "Desactivado"

msgid "Automatic: follows the calendar of celebrations"
msgstr "Automático: sigue el calendario de celebraciones"

msgid "Fixed theme (every day)"
msgstr "Tema fijo (todos los días)"

msgid "Today: %s"
msgstr "Hoy: %s"

msgid "Today: no celebration · next: %1$s, from %2$s"
msgstr "Hoy: ninguna celebración · próxima: %1$s, desde el %2$s"

msgid "Active every day"
msgstr "Activo todos los días"

msgid "Celebrations included in the automatic calendar:"
msgstr "Celebraciones incluidas en el calendario automático:"

msgid "Effects of the themes:"
msgstr "Efectos de las temporadas:"

msgid "Decoration on the illustration"
msgstr "Adornos sobre la ilustración"

msgid "Garland, pennants or lights along the top"
msgstr "Guirnalda, banderines o luces en la parte superior"

msgid "Animated effect (snow, confetti, petals, hearts...)"
msgstr "Efecto animado (nieve, confeti, pétalos, corazones...)"

msgid "Animations are disabled for users who ask their system to reduce motion."
msgstr "Las animaciones se desactivan para quienes configuraron su sistema para reducir el movimiento."

msgid "The clock and the furniture decoration apply to the default illustrations of the portal. If an entity uses other illustrations, only the lights and the snowfall are shown."
msgstr "El reloj y la decoración de los muebles aplican a las ilustraciones predeterminadas del portal. Si una entidad usa otras ilustraciones, solo se muestran las luces y la nieve."

msgid "How can we help you?"
msgstr "¿Cómo podemos ayudarte?"

msgid "Show in the preview:"
msgstr "Ver en la vista previa:"

msgid "Tiles of the self-service home page"
msgstr "Tarjetas del inicio del portal de autoservicio"

msgid "Use all the suggestions"
msgstr "Usar todas las sugerencias"

msgid "GLPI saves these texts in the database when it creates the tiles, in the language used at that moment, so the language files do not translate them. Edit them here; the changes apply to everyone."
msgstr "GLPI guarda estos textos en la base de datos al crear las tarjetas, en el idioma que se usaba en ese momento, por eso los archivos de idioma no los traducen. Edítelos aquí; los cambios aplican para todos."

msgid "No tiles found (GLPI 11 or later is needed)."
msgstr "No se encontraron tarjetas (se necesita GLPI 11 o posterior)."

msgid "Tile"
msgstr "Tarjeta"

msgid "Use suggestion"
msgstr "Usar sugerencia"

msgid "Suggestion:"
msgstr "Sugerencia:"

msgid "Form tiles show the name and description of the form: changing them here also changes them in the service catalog. If a tile has a translation for the user language (Setup > General > Helpdesk translations), that translation is shown instead."
msgstr "Las tarjetas de formulario muestran el nombre y la descripción del formulario: cambiarlos aquí también los cambia en el catálogo de servicios. Si una tarjeta tiene traducción para el idioma del usuario (Configuración > General > Traducciones del helpdesk), se muestra esa traducción."

msgid "GLPI interface texts"
msgstr "Textos de la interfaz de GLPI"

msgid "Replace any text of GLPI that is untranslated or badly translated. The changes are kept apart from GLPI, so they survive its updates, and stop applying if the plugin is disabled."
msgstr "Reemplace cualquier texto de GLPI que esté sin traducir o mal traducido. Los cambios se guardan aparte de GLPI, así que se conservan al actualizarlo, y dejan de aplicar si se desactiva el plugin."

msgid "Suggested corrections"
msgstr "Correcciones sugeridas"

msgid "the GLPI translation has texts that do not fit this language (for example the \"voseo\": \"Solicitá\", \"Usá\")."
msgstr "la traducción de GLPI tiene textos que no corresponden a este idioma (por ejemplo el voseo: \"Solicitá\", \"Usá\")."

msgid "Add %d corrections"
msgstr "Agregar %d correcciones"

msgid "Search a text as you see it in GLPI (in English or in the translation)..."
msgstr "Busque un texto tal como lo ve en GLPI (en inglés o en la traducción)..."

msgid "No custom texts yet: search for a text above to change it."
msgstr "Aún no hay textos personalizados: busque un texto arriba para cambiarlo."

msgid "Remove"
msgstr "Quitar"

msgid "Singular"
msgstr "Singular"

msgid "Plural"
msgstr "Plural"

msgid "(untranslated)"
msgstr "(sin traducir)"

msgid "No texts found"
msgstr "No se encontraron textos"

msgid "Change"
msgstr "Cambiar"

msgid "Already in the list"
msgstr "Ya está en la lista"

msgid "Original text (English)"
msgstr "Texto original (inglés)"

msgid "Current GLPI translation"
msgstr "Traducción actual de GLPI"

msgid "Your text"
msgstr "Su texto"

msgid "Changes apply when you press Save. Texts of other plugins are not included."
msgstr "Los cambios se aplican al pulsar Guardar. No incluye los textos de otros plugins."

msgid "Logos and favicon may need a hard refresh (Ctrl+F5) to show up."
msgstr "Puede que los logos y el favicon necesiten recargar con Ctrl+F5 para verse."
